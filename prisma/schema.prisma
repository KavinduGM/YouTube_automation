// YouTube Automation — data model
// All times stored UTC; rendered in America/New_York in the UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Channels ─────────
// One row per YouTube channel (OAP, OAG, Nursing).
// Holds the OAuth refresh token used to upload to that channel.
model Channel {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  // Uppercase prefix used in filenames, e.g. "OAP", "ABT".
  // Nullable to ease migration; bootstrap + API require it for new channels.
  filenamePrefix      String?  @unique
  youtubeChannelId    String?
  refreshTokenEnc     String?
  scopes              String?
  // Timestamp of the latest successful YouTube OAuth connect. Used to surface
  // an "active / reconnect soon / expired" badge — Google issues 7-day
  // refresh tokens to unverified apps in Testing mode.
  youtubeConnectedAt  DateTime?

  // Content flags — what this channel publishes.
  hasQuestionVideos   Boolean  @default(false)
  hasAnimationVideos  Boolean  @default(false)
  hasShortVideos      Boolean  @default(true)

  // Legacy fallback fields (use ChannelMonth instead).
  driveFolderId       String?
  publishedFolderId   String?
  rawArchiveFolderId  String?
  defaultSheetId      String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  contentItems        ContentItem[]
  publishSlots        PublishSlot[]
  editorTasks         EditorTask[]
  months              ChannelMonth[]
}

// ───────── Per-month channel folders ─────────
// One row per (channel, month). Lets the admin manage Drive folders +
// sheets month-by-month without hand-editing channel settings each cycle.
// The raw-watcher iterates every active ChannelMonth, so May raws land in
// May slots and June raws land in June slots automatically.
model ChannelMonth {
  id                  String      @id @default(cuid())
  channelId           String
  channel             Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  month               String      // "YYYY-MM" — what month this folder is for

  driveFolderId       String?     // working folder where raws + finals land
  publishedFolderId   String?     // finals moved here after YouTube publish
  rawArchiveFolderId  String?     // raws moved here after editor submits
  defaultSheetId      String?     // sheet for write-back this month

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([channelId, month])
  @@index([channelId])
}

// ───────── Google service connection (for Drive + Sheets) ─────────
model GoogleConnection {
  id                  String   @id @default(cuid())
  email               String   @unique
  refreshTokenEnc     String
  scopes              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ───────── Content items (planned + tracked) ─────────
enum ContentType {
  long
  short
  post   // reserved for future; v1 does not auto-publish posts
}

// Sub-format for long videos. Channels with both flags on alternate
// question/animation slots in their publishing schedule.
enum VideoFormat {
  question
  animation
}

enum ContentStatus {
  planned            // metadata exists, no file yet
  uploaded           // file detected in Drive, awaiting approval
  pending_approval   // matched + emailed reviewer
  approved           // human approved, queued for upload
  scheduling         // being uploaded to YouTube right now
  scheduled          // uploaded to YouTube with publishAt
  published          // confirmed live
  failed             // upload or scheduling failed
  rejected           // human rejected
  canceled           // manually canceled
}

model ContentItem {
  id                String        @id @default(cuid())
  channelId         String
  channel           Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)

  type              ContentType
  format            VideoFormat?  // long: question | animation; short: null
  expectedFilename  String        @unique
  examTag           String?

  // Metadata pre-filled by team
  title             String
  description       String        @db.Text
  tags              String[]      @default([])
  categoryId        String        @default("27")     // Education
  defaultLanguage   String        @default("en-US")  // US English
  recordingCountry  String        @default("US")     // ISO 3166-1 alpha-2
  madeForKids       Boolean       @default(false)

  scheduledPublishAt DateTime

  status            ContentStatus @default(planned)
  driveFileId       String?
  driveThumbId      String?
  youtubeVideoId    String?
  youtubeUrl        String?

  uploadedAt        DateTime?
  approvedAt        DateTime?
  approvedById      String?
  approvedBy        User?         @relation(fields: [approvedById], references: [id])
  rejectedReason    String?

  sheetId           String?
  sheetTab          String?
  sheetRow          Int?

  lastError         String?
  attempts          Int           @default(0)

  // YouTube playlists to add this video to AFTER successful upload.
  // Empty = don't add to any. Order is preserved.
  playlistIds       String[]      @default([])

  // Manual "Studio-only" checklist — tracks which post-upload fields the
  // approver has set in YouTube Studio. Stored as JSON like
  //   { "aiUse": true, "captionCert": false, "shortsRemix": true,
  //     "eduLevel": false, "endScreen": false, "cards": false }
  // null = nothing checked yet.
  polishChecks      Json?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events            ContentEvent[]
  editorTask        EditorTask?
  publishSlot       PublishSlot?

  @@index([channelId, status])
  @@index([scheduledPublishAt])
  @@index([status])
}

model ContentEvent {
  id              String       @id @default(cuid())
  contentItemId   String
  contentItem     ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  type            String
  actorEmail      String?
  message         String?
  meta            Json?
  createdAt       DateTime     @default(now())

  @@index([contentItemId, createdAt])
}

// ───────── Publish slots ─────────
// Pre-defined publishing moments per channel + content type. As raw videos
// come in, the next available slot is consumed and the item gets that time.
enum SlotStatus {
  available   // ready to be assigned to a new ContentItem
  assigned    // tied to a ContentItem (may or may not be uploaded yet)
  used        // ContentItem has been published
  skipped     // manually marked unused
}

model PublishSlot {
  id              String      @id @default(cuid())
  channelId       String
  channel         Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  type            ContentType
  format          VideoFormat?  // long: question | animation; short: null
  name            String?       // optional label, e.g. "Morning long"
  scheduledAt     DateTime
  status          SlotStatus  @default(available)

  assignedItemId  String?     @unique
  assignedItem    ContentItem? @relation(fields: [assignedItemId], references: [id], onDelete: SetNull)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([channelId, type, format, status, scheduledAt])
  @@unique([channelId, scheduledAt, type, format])
}

// ───────── Editor tasks ─────────
// A raw upload from admin produces an EditorTask. The editor downloads
// the raw, edits, and uploads the final (which fulfils the linked
// ContentItem). One ContentItem per task.
enum EditorTaskStatus {
  pending             // raw detected, waiting for editor
  ongoing             // editor is working on it
  submitted           // editor marked done — shows as "In Review" in UI
  revision_requested  // admin asked for changes
  completed           // admin approved the final video
  canceled
}

model EditorTask {
  id                String              @id @default(cuid())
  channelId         String
  channel           Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)

  rawDriveFileId    String              @unique
  rawFilename       String
  rawTag            String

  // The ContentItem the editor's final upload will fulfil
  contentItemId     String?             @unique
  contentItem       ContentItem?        @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  assignedEditorId  String?
  assignedEditor    User?               @relation(fields: [assignedEditorId], references: [id])

  detectedType      ContentType?
  detectedFormat    VideoFormat?  // parsed from filename suffix
  durationMillis    Int?

  status            EditorTaskStatus    @default(pending)
  revisionNotes     String?

  docs              EditorTaskDoc[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  startedAt         DateTime?
  submittedAt       DateTime?
  completedAt       DateTime?

  @@index([status, createdAt])
  @@index([channelId, status])
}

// Auxiliary docs alongside a raw video (theory.txt, question.txt, etc.).
model EditorTaskDoc {
  id              String      @id @default(cuid())
  taskId          String
  task            EditorTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  driveFileId     String
  filename        String
  mimeType        String?
  kind            String?     // "theory" | "question" | "other"
  sizeBytes       Int?
  createdAt       DateTime    @default(now())
}

// ───────── Auth ─────────
enum UserRole {
  admin
  manager
  editor
}

model User {
  id              String      @id @default(cuid())
  // Username is the login identifier. Nullable to allow zero-downtime
  // migration from the previous email-only schema; new users always have
  // a username set, and the login route requires it.
  username        String?     @unique
  email           String?     @unique
  passwordHash    String?
  name            String?
  role            UserRole    @default(admin)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt @default(now())

  approvedItems   ContentItem[]
  assignedTasks   EditorTask[]
  sessions        Session[]
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}
