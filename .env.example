# ───────── Core ─────────
NODE_ENV=development
TZ=America/New_York
DASHBOARD_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# ───────── Database ─────────
# Local: postgres://yt:yt@localhost:5432/yt
DATABASE_URL=postgres://yt:yt@localhost:5432/yt

# ───────── Auth (dashboard) ─────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-hex-string
# Comma-separated list of approver emails who can sign in
ALLOWED_APPROVER_EMAILS=you@example.com

# ───────── Encryption (OAuth tokens at rest) ─────────
# 32 bytes hex (64 chars). Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=change-me-32-bytes-hex

# ───────── Google (Drive + Sheets + YouTube) ─────────
# Single OAuth client used for all 3 channels and Drive/Sheets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match what you register in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/google/callback

# ───────── Resend (email) ─────────
RESEND_API_KEY=
RESEND_FROM="YT Automation <noreply@yourdomain.com>"

# ───────── Worker tuning ─────────
DRIVE_POLL_INTERVAL_SECONDS=120
SCHEDULER_INTERVAL_SECONDS=60
TMP_DIR=./tmp

# ───────── Logging ─────────
LOG_LEVEL=info
