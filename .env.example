# ───────── Core ─────────
NODE_ENV=production
TZ=America/New_York

# Public-facing URLs — what the browser sees. Used in CORS + emails.
DASHBOARD_URL=https://dashboard.yourdomain.com
API_URL=http://api:4000          # internal Docker hostname (dashboard server-side calls)
API_PORT=4000

# Domains for Caddy auto-TLS. DNS A records must point at this host.
DASHBOARD_DOMAIN=dashboard.yourdomain.com
API_DOMAIN=api.yourdomain.com
ACME_EMAIL=you@example.com

# ───────── Database ─────────
# 'postgres' = Docker service name; user/pass match the postgres service env below.
DATABASE_URL=postgres://yt:CHANGE_ME@postgres:5432/yt
POSTGRES_USER=yt
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=yt

# ───────── Auth (dashboard) ─────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
# Comma-separated list of approver emails who can sign in
ALLOWED_APPROVER_EMAILS=you@example.com

# ───────── Encryption (OAuth tokens at rest) ─────────
# 32 bytes hex (64 chars). Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ───────── Google (Drive + Sheets + YouTube) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match what you register in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=https://api.yourdomain.com/oauth/google/callback

# ───────── Resend (email) ─────────
RESEND_API_KEY=
RESEND_FROM="YT Automation <noreply@yourdomain.com>"

# ───────── Worker tuning ─────────
DRIVE_POLL_INTERVAL_SECONDS=120
SCHEDULER_INTERVAL_SECONDS=60
TMP_DIR=/app/tmp

# ───────── Logging ─────────
LOG_LEVEL=info
