# ───────── Core ─────────
NODE_ENV=production
TZ=America/New_York

# Public-facing URLs — what the browser sees. Used in CORS + emails.
DASHBOARD_URL=https://dashboard.yourdomain.com

# Internal Docker hostname for the API (used by the dashboard server-side).
# Leave as-is when deploying via docker-compose / Dokploy.
API_URL=http://api:4000
API_PORT=4000

# ───────── Database ─────────
# Point at your external Postgres. On Dokploy, the host is the App Name of
# your Postgres service (e.g. yt-automation-postgres). On local dev with the
# old bundled Postgres, use postgres://yt:yt@postgres:5432/yt.
DATABASE_URL=postgres://yt:CHANGE_ME@yt-automation-postgres:5432/yt

# ───────── Auth (dashboard) ─────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
# Comma-separated list of approver emails who can sign in
ALLOWED_APPROVER_EMAILS=you@example.com

# ───────── Encryption (OAuth tokens at rest) ─────────
# 32 bytes hex (64 chars). Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ───────── Google (Drive + Sheets + YouTube) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match what you register in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=https://api.yourdomain.com/oauth/google/callback

# ───────── Resend (email) ─────────
RESEND_API_KEY=
RESEND_FROM="YT Automation <noreply@yourdomain.com>"

# ───────── Worker tuning ─────────
DRIVE_POLL_INTERVAL_SECONDS=120
SCHEDULER_INTERVAL_SECONDS=60
TMP_DIR=/app/tmp

# ───────── Logging ─────────
LOG_LEVEL=info
